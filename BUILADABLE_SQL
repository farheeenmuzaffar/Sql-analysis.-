CREATE TABLE customer (
    CustomerID INT PRIMARY KEY,
    Gender VARCHAR(50) NOT NULL,
    Age INT NOT NULL,
    `Annual Income ($)` INT NOT NULL,       -- Fixed: using backticks
    `Spending Score (1-100)` INT NOT NULL,  -- Fixed: using backticks
    Profession VARCHAR(100),
    `Work Experience` INT,                  -- Fixed: using backticks
    `Family Size` INT                       -- Fixed: using backticks and removed semicolon
);
ALTER TABLE customer
ADD COLUMN Registration_Date DATE,
ADD COLUMN Total_Orders INT;

