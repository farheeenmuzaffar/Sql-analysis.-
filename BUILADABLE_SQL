    CustomerID INT PRIMARY KEY,
    Gender VARCHAR(50) NOT NULL,
    Age INT NOT NULL,
    `Annual Income ($)` INT NOT NULL,       -- Fixed: using backtick
    `Spending Score (1-100)` INT NOT NULL,  -- Fixed: using backticks
    Profession VARCHAR(100),
    `Work Experience` INT,                  -- Fixed: using backticks
